# Настройки сервиса анкет. Скопируйте в .env (в git не попадает).
# ADMIN_KEY и три переменные S3_* задаются ещё и в настройках контейнера в Cloud.ru.

# Ключ страницы именинника: <сайт>/guests/<ADMIN_KEY>. Длинная случайная строка.
ADMIN_KEY=

# Название бакета в Cloud.ru Object Storage, где лежит файл с анкетами (guests.json).
S3_BUCKET=
# Идентификатор ключа для хранилища: <tenant_id>:<key_id>.
S3_ACCESS_KEY_ID=
# Key Secret того же ключа доступа.
S3_SECRET_ACCESS_KEY=

# URI реестра образов из Artifact Registry: <название>.cr.cloud.ru. Нужен только для npm run deploy.
REGISTRY=
